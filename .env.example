# Discord
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_CHANNEL_ID=123456789012345678

# Life360
LIFE360_USERNAME=neelemanjack@gmail.com
LIFE360_ACCESS_TOKEN=replace-with-life360-access-token
LIFE360_BASE_URL=https://api-cloudfront.life360.com/v3
LIFE360_IMPERSONATE=chrome124

# Optional fallback: only needed if you want the bot to fetch a token from a
# Life360 username/password instead of using LIFE360_ACCESS_TOKEN.
# LIFE360_PASSWORD=
# LIFE360_CLIENT_BASIC=

# Pick Neil either by Life360 member id or by display/name/firstName match.
# LIFE360_MEMBER_ID=
LIFE360_MEMBER_NAME=Neil

# Optional: pin a circle by id. If empty, all circles are searched.
# LIFE360_CIRCLE_ID=

# Polling/state
POLL_SECONDS=300
STATE_FILE=state.json
ANNOUNCE_ON_STARTUP=false

# Reverse geocoding via OpenStreetMap Nominatim. Keep this identifiable.
NOMINATIM_USER_AGENT=neil-track-discord-bot/1.0

# Message template variables: {name}, {city}, {state}, {country}, {place}, {lat}, {lon}, {route_percent}, {route_percent_rounded}
DISCORD_MESSAGE_TEMPLATE={name} just arrived in {place}. He is {route_percent}% of the way from Seattle to Austin.
